# Redirecionar index.php para a pasta pai (SEO)
RewriteEngine On
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /loja/index\.php\ HTTP/
RewriteRule ^index\.php$ https://4u.ia.br/loja/ [R=301,L]

# Remover .php da URL (opcional, mas bom para limpeza)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]
